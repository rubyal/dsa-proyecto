FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit>=1.30.0 \
    pandas>=2.0 \
    plotly>=5.18.0 \
    requests>=2.31.0 \
    pyarrow>=14.0

COPY dashboard/app.py /app/dashboard/app.py
COPY data/raw/nyc311_diario_borough_tipo.parquet /app/data/raw/nyc311_diario_borough_tipo.parquet
COPY data/processed/dataset_modelado_semanal.parquet /app/data/processed/dataset_modelado_semanal.parquet

RUN mkdir /app/.git

EXPOSE 8501
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
