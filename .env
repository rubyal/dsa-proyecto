# ──────────────────────────────────────────────
# Variables de entorno del proyecto DSA
# ──────────────────────────────────────────────

# Nombre del bucket S3 creado por Terraform (output "bucket_name")
S3_BUCKET_NAME=miad-dsa-proyecto-8fe988a7

# Región AWS
AWS_DEFAULT_REGION=us-east-1

# Credenciales AWS — se pasan al contenedor para dvc pull/push
# (déjalas vacías si ya las tienes exportadas en tu terminal)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
